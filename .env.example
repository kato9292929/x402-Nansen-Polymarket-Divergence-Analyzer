# Nansen
NANSEN_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# EVM 受取ウォレット (Base / Polygon)
WALLET_ADDRESS=0xC67d94504696960bA0f2e7C3FeE703950734c00A

# Solana 受取ウォレット (base58)
SOLANA_WALLET_ADDRESS=

# Coinbase Developer Platform (CDP) API keys — production x402 facilitator
# When both are set the app authenticates with the CDP facilitator at FACILITATOR_URL.
# Leave both empty to fall back to the community facilitator (no auth, no SLA).
CDP_API_KEY_ID=         # UUID 形式 (xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
CDP_API_KEY_SECRET=     # base64 形式 (末尾 ==)

# Facilitator URL
FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# アプリURL (x402 resource フィールドに使用)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Helius RPC (Solana)
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
NEXT_PUBLIC_HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# WalletConnect (未設定時は "placeholder" フォールバック)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=placeholder

# JPYC (Polygon ERC-20)
NEXT_PUBLIC_JPYC_CONTRACT=0x431D5dfF03120AFA4bDf332c61A6e1766eF37BF

# Vercel KV / Upstash Redis (Vercel Storage から自動追加)
KV_REST_API_URL=
KV_REST_API_TOKEN=
